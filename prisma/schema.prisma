datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SubscriptionPlan {
  FREE
  PLUS
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIAL
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  EXPIRE
  CANCEL
  FAILURE
}

model Tenant {
  id                    String                @id @default(uuid())
  name                  String
  slug                  String                @unique
  plan                  SubscriptionPlan      @default(FREE)
  planStatus            SubscriptionStatus    @default(ACTIVE)
  billingCycle          String?               // "monthly" | "yearly"
  subscriptionExpiresAt DateTime?

  branches              Branch[]
  roles                 Role[]
  users                 User[]
  payments              SubscriptionPayment[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([slug])
}

model SubscriptionPayment {
  id              String           @id @default(uuid())
  orderId         String           @unique // Format: SUB-<tenantSlug>-<timestamp>
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan
  billingCycle    String           // "monthly" | "yearly"
  amount          Int
  status          PaymentStatus    @default(PENDING)
  snapToken       String?
  snapRedirectUrl String?
  paymentType     String?          // e.g. qris, gopay, bank_transfer
  rawResponse     Json?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([orderId])
}

model Branch {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String       // Default: "Cabang Utama"
  isMain       Boolean      @default(true)

  userBranches UserBranch[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // OWNER, KASIR, ADMIN
  permissions Json     // Format array string, misal: ["*"]

  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model User {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId       String?
  role         Role?        @relation(fields: [roleId], references: [id])

  name         String
  email        String
  password     String
  isOwner      Boolean      @default(false)
  isActive     Boolean      @default(true)

  userBranches UserBranch[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model UserBranch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
}
