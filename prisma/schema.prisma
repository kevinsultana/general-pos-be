datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SubscriptionPlan {
  FREE
  PLUS
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIAL
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  EXPIRE
  CANCEL
  FAILURE
}

model Tenant {
  id                    String                @id @default(uuid())
  name                  String
  slug                  String                @unique
  plan                  SubscriptionPlan      @default(FREE)
  planStatus            SubscriptionStatus    @default(ACTIVE)
  billingCycle          String?               // "monthly" | "yearly"
  subscriptionExpiresAt DateTime?
  proJoinedAt           DateTime?             // Tanggal pertama kali upgrade ke paket PRO

  branches              Branch[]
  roles                 Role[]
  users                 User[]
  payments              SubscriptionPayment[]
  products              Product[]
  shifts                Shift[]
  customers             Customer[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([slug])
}

model SubscriptionPayment {
  id              String           @id @default(uuid())
  orderId         String           @unique // Format: SUB-<tenantSlug>-<timestamp>
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan
  billingCycle    String           // "monthly" | "yearly"
  amount          Int
  status          PaymentStatus    @default(PENDING)
  snapToken       String?
  snapRedirectUrl String?
  paymentType     String?          // e.g. qris, gopay, bank_transfer
  rawResponse     Json?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([orderId])
}

model Branch {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String       // Default: "Cabang Utama"
  address      String?
  phone        String?
  isActive     Boolean      @default(true)
  isMain       Boolean      @default(true)

  userBranches UserBranch[]
  shifts       Shift[]
  products     Product[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // OWNER, KASIR, ADMIN, MANAGER
  description String?
  isSystem    Boolean  @default(false)
  permissions Json     // Format array string, misal: ["*"]

  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model User {
  id                String       @id @default(uuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId            String?
  role              Role?        @relation(fields: [roleId], references: [id])

  name              String
  email             String
  password          String
  phone             String?
  pin               String?
  isOwner           Boolean      @default(false)
  isActive          Boolean      @default(true)
  allBranchesAccess Boolean      @default(false)

  userBranches      UserBranch[]
  shifts            Shift[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model UserBranch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isDefault Boolean  @default(false)

  @@unique([userId, branchId])
}

// ─── POS MVP Models ───────────────────────────────────────────────────────────

model Product {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  variants    ProductVariant[]

  @@index([tenantId])
  @@index([tenantId, branchId])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  name      String   // "Regular" jika produk tidak punya varian tambahan
  costPrice Decimal  @default(0) @db.Decimal(12, 2)
  price     Decimal  @default(0) @db.Decimal(12, 2)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  items     TransactionItem[]

  @@index([productId])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Shift {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id])
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  startTime    DateTime      @default(now())
  endTime      DateTime?
  startingCash Decimal       @default(0) @db.Decimal(12, 2)
  endingCash   Decimal?      @db.Decimal(12, 2)
  status       ShiftStatus   @default(OPEN)

  transactions Transaction[]

  @@index([tenantId, branchId, status])
}

model Transaction {
  id            String            @id @default(uuid())
  tenantId      String
  branchId      String
  shiftId       String
  customerId    String?
  customerName  String?
  customerPhone String?
  receiptNumber String            @unique
  totalAmount   Decimal           @db.Decimal(12, 2)
  totalCost     Decimal           @db.Decimal(12, 2)
  paymentMethod String            // "CASH", "QRIS", "TRANSFER"
  createdAt     DateTime          @default(now())

  shift         Shift             @relation(fields: [shiftId], references: [id])
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         TransactionItem[]

  @@index([tenantId, branchId])
  @@index([shiftId])
  @@index([tenantId, customerId])
}

model TransactionItem {
  id               String         @id @default(uuid())
  transactionId    String
  productVariantId String
  productName      String
  variantName      String
  quantity         Int
  costPrice        Decimal        @db.Decimal(12, 2)
  price            Decimal        @db.Decimal(12, 2)
  subtotal         Decimal        @db.Decimal(12, 2)

  transaction      Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Customer {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  email        String?
  address      String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  transactions Transaction[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}
