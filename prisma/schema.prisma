datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SubscriptionPlan {
  FREE
  PLUS
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIAL
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  EXPIRE
  CANCEL
  FAILURE
}

model Tenant {
  id                    String                @id @default(uuid())
  name                  String
  slug                  String                @unique
  plan                  SubscriptionPlan      @default(FREE)
  planStatus            SubscriptionStatus    @default(ACTIVE)
  billingCycle          String?               // "monthly" | "yearly"
  subscriptionExpiresAt DateTime?
  proJoinedAt           DateTime?             // Tanggal pertama kali upgrade ke paket PRO

  branches              Branch[]
  roles                 Role[]
  users                 User[]
  payments              SubscriptionPayment[]
  products              Product[]
  shifts                Shift[]
  customers             Customer[]
  orders                Order[]
  promotions            Promotion[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([slug])
}

model SubscriptionPayment {
  id              String           @id @default(uuid())
  orderId         String           @unique // Format: SUB-<tenantSlug>-<timestamp>
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan
  billingCycle    String           // "monthly" | "yearly"
  amount          Int
  status          PaymentStatus    @default(PENDING)
  snapToken       String?
  snapRedirectUrl String?
  paymentType     String?          // e.g. qris, gopay, bank_transfer
  rawResponse     Json?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tenantId])
  @@index([orderId])
}

model Branch {
  id           String       @id @default(uuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String       // Default: "Cabang Utama"
  address      String?
  phone        String?
  isActive     Boolean      @default(true)
  isMain       Boolean      @default(true)

  userBranches UserBranch[]
  shifts       Shift[]
  products     Product[]
  orders       Order[]
  promotions   Promotion[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([tenantId])
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   // OWNER, KASIR, ADMIN, MANAGER
  description String?
  isSystem    Boolean  @default(false)
  permissions Json     // Format array string, misal: ["*"]

  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model User {
  id                String       @id @default(uuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId            String?
  role              Role?        @relation(fields: [roleId], references: [id])

  name              String
  email             String
  password          String
  phone             String?
  pin               String?
  isOwner           Boolean      @default(false)
  isActive          Boolean      @default(true)
  allBranchesAccess Boolean      @default(false)

  userBranches      UserBranch[]
  shifts            Shift[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model UserBranch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isDefault Boolean  @default(false)

  @@unique([userId, branchId])
}

// ─── POS MVP Models ───────────────────────────────────────────────────────────

model Product {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name        String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  variants    ProductVariant[]

  @@index([tenantId])
  @@index([tenantId, branchId])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  name      String   // "Regular" jika produk tidak punya varian tambahan
  costPrice Decimal  @default(0) @db.Decimal(12, 2)
  price     Decimal  @default(0) @db.Decimal(12, 2)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  items     TransactionItem[]
  orderItems OrderItem[]

  @@index([productId])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Shift {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch        @relation(fields: [branchId], references: [id])
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  startTime    DateTime      @default(now())
  endTime      DateTime?
  startingCash Decimal       @default(0) @db.Decimal(12, 2)
  endingCash   Decimal?      @db.Decimal(12, 2)
  status       ShiftStatus   @default(OPEN)

  transactions Transaction[]

  @@index([tenantId, branchId, status])
}

model Transaction {
  id            String            @id @default(uuid())
  tenantId      String
  branchId      String
  shiftId       String
  customerId    String?
  customerName  String?
  customerPhone String?
  receiptNumber String            @unique
  totalAmount   Decimal           @db.Decimal(12, 2)
  totalCost     Decimal           @db.Decimal(12, 2)
  paymentMethod String            // "CASH", "QRIS", "TRANSFER"
  createdAt     DateTime          @default(now())

  shift         Shift             @relation(fields: [shiftId], references: [id])
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         TransactionItem[]
  order         Order?

  @@index([tenantId, branchId])
  @@index([shiftId])
  @@index([tenantId, customerId])
}

model TransactionItem {
  id               String         @id @default(uuid())
  transactionId    String
  productVariantId String
  productName      String
  variantName      String
  quantity         Int
  costPrice        Decimal        @db.Decimal(12, 2)
  price            Decimal        @db.Decimal(12, 2)
  subtotal         Decimal        @db.Decimal(12, 2)

  transaction      Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Customer {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  email        String?
  address      String?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  transactions Transaction[]
  orders       Order[]

  @@unique([tenantId, phone])
  @@index([tenantId])
}

// ─── Self-Ordering & Barcode/QR Orders ──────────────────────────────────────────

enum OrderStatus {
  PENDING     // Pesanan dibuat oleh pelanggan, menunggu diproses kasir
  COMPLETED   // Pesanan selesai & telah dibayar melalui kasir POS
  CANCELLED   // Dibatalkan
}

enum OrderType {
  DINE_IN     // Makan di tempat (bisa dengan nomor meja)
  TAKEAWAY    // Bungkus / bawa pulang
}

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique // Kode unik pendek untuk barcode scanner, cth: "ORD-882194"
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  orderType     OrderType     @default(DINE_IN)
  tableNumber   String?
  status        OrderStatus   @default(PENDING)
  totalAmount   Decimal       @db.Decimal(12, 2)
  notes         String?
  transactionId String?       @unique
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         OrderItem[]

  @@index([tenantId, branchId, status])
  @@index([orderNumber])
}

model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String
  variant          ProductVariant @relation(fields: [productVariantId], references: [id])
  productName      String
  variantName      String
  price            Decimal        @db.Decimal(12, 2)
  costPrice        Decimal        @default(0) @db.Decimal(12, 2)
  quantity         Int
  subtotal         Decimal        @db.Decimal(12, 2)
  notes            String?

  @@index([orderId])
}

// ─── Promotion & Discount System ─────────────────────────────────────────────

enum DiscountType {
  PERCENTAGE   // Persentase (cth: 10%)
  FIXED        // Nominal tetap (cth: Rp 5.000)
}

enum PromoScope {
  ALL          // Berlaku untuk semua produk di keranjang
  PRODUCT      // Hanya berlaku jika ada produk/varian tertentu di keranjang
}

model Promotion {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?       // Cabang pemilik promo (null = berlaku di semua cabang)
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  name            String        // Nama promo, cth: "Diskon 10% Weekend"
  code            String        // Kode kupon, cth: "DISKON10"
  description     String?       // Deskripsi singkat promo

  discountType    DiscountType  // PERCENTAGE atau FIXED
  discountValue   Decimal       @db.Decimal(12, 2)  // Nilai diskon (% atau Rp)
  maxDiscount     Decimal?      @db.Decimal(12, 2)  // Batas maksimal potongan (untuk PERCENTAGE)
  minPurchase     Decimal       @default(0) @db.Decimal(12, 2) // Minimum belanja agar promo berlaku

  scope           PromoScope    @default(ALL)        // Cakupan promo
  // Untuk scope PRODUCT: array variantId yang disyaratkan ada di keranjang
  scopeVariantIds Json?         // String[] — variantId yang harus ada di cart

  usageLimit      Int?          // Batas total pemakaian promo per cabang / tenant (null = tidak terbatas)
  usageCount      Int           @default(0)          // Sudah digunakan berapa kali

  isActive        Boolean       @default(true)
  startDate       DateTime?     // Mulai berlaku (null = langsung aktif)
  endDate         DateTime?     // Berakhir (null = tidak ada batas waktu)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([tenantId, branchId, isActive])
  @@index([tenantId, code])
}
