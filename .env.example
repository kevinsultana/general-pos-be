# =============================================================================
# OmniPOS Backend — Environment Variables Template
# =============================================================================
# Salin file ini ke .env dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke version control!
# =============================================================================

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/omnipos_dev?schema=public"

# JWT Authentication
# Generate dengan: openssl rand -hex 32
# WAJIB minimal 32 karakter, JANGAN gunakan nilai default di production!
JWT_SECRET="GANTI-DENGAN-RANDOM-STRING-MIN-64-KARAKTER-GUNAKAN-openssl-rand-hex-32"
JWT_EXPIRES_IN="1d"

# Midtrans Payment Gateway
# Dapatkan dari: https://dashboard.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY="Mid-server-XXXXXXXXXXXXXXXXXXXXXXXXX"
MIDTRANS_CLIENT_KEY="Mid-client-XXXXXXXXXXXXXXXXXXXXXXXXX"
MIDTRANS_IS_PRODUCTION=false

# Frontend URL (untuk CORS whitelist)
FRONTEND_URL="http://localhost:3000"
