# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL with Multi-tenant schema / database support)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnipos_dev?schema=public"

# JWT Authentication
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Midtrans Payment Gateway Configuration
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxx
MIDTRANS_IS_PRODUCTION=false

